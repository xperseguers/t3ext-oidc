{
	"name": "somebdyelse/oidc-v14",
	"type": "project",
	"config": {
		"allow-plugins": {
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true
		},
		"platform": {
			"php": "8.5",
			"ext-intl": "1"
		},
		"sort-packages": true
	},
	"require": {
		"causal/oidc": "@dev",
		"helhum/typo3-console": "9.0.x-dev",
		"somebdyelse/oidc-sitepackage": "@dev"
	},
	"repositories": [
		{
			"type": "path",
			"url": "./packages/*"
		}
	]
}
